# Local PostgreSQL defaults from docker-compose.yml
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/task_me_please
SPRING_DATASOURCE_USERNAME=postgres_user
SPRING_DATASOURCE_PASSWORD=postgres_password

# Application
APP_BASE_URL=http://localhost:8181
PORT=8181
JTE_DEVELOPMENT_MODE=true
REMEMBER_ME_KEY=replace-with-a-long-random-secret

# Brevo Transactional Email API
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_CONNECT_TIMEOUT=5s
BREVO_READ_TIMEOUT=5s
MAIL_FROM=replace-with-a-verified-brevo-sender@example.com
